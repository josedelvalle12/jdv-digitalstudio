# Dominio definitivo del sitio (sin barra final), usado para metadataBase,
# canonical, hreflang, Open Graph, robots.txt y sitemap.xml.
# Local: copiá este archivo a .env.local y completá el valor real.
# Railway: cargalo como variable del servicio ANTES del primer build
# (las variables NEXT_PUBLIC_ se fijan al compilar; si la cambiás, redeploy).
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Formulario de la landing (/api/contacto), envío por Resend.
# Sin RESEND_API_KEY el formulario no envía nada y responde error (503).
RESEND_API_KEY=re_xxxxxxxx
# Opcionales (estos son los valores por defecto):
# CONTACT_TO=hola@josedelvalle.dev
# CONTACT_FROM=JDV Digital Studio <hola@josedelvalle.dev>
